page { background: #f3f6f9; color: #102a43; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; font-size: 28rpx; }
view, input, button, textarea { box-sizing: border-box; }
.page { padding: 32rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.hero { padding: 16rpx 0 28rpx; }
.eyebrow { color: #087f8c; font-size: 23rpx; font-weight: 600; letter-spacing: 3rpx; margin-bottom: 12rpx; }
.title { font-size: 46rpx; font-weight: 700; line-height: 1.3; }
.subtitle, .muted { color: #6b7c8e; font-size: 25rpx; line-height: 1.7; }
.subtitle { margin-top: 12rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 30rpx; margin-bottom: 24rpx; border: 1rpx solid #e4ebf0; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.name { font-weight: 600; font-size: 32rpx; line-height: 1.5; flex: 1; word-break: break-all; }
.badge { background: #e6f4f3; color: #087f8c; font-size: 23rpx; border-radius: 10rpx; padding: 7rpx 14rpx; white-space: nowrap; }
.badge.completed, .badge.disabled { background: #eef1f4; color: #6b7c8e; }
.badge.maintenance { background: #fff3dc; color: #9b6c12; }
.stats { display: flex; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #eef2f6; }
.stat { flex: 1; }
.number { font-size: 40rpx; font-weight: 700; margin-bottom: 4rpx; }
.label { font-size: 25rpx; font-weight: 500; margin: 26rpx 0 12rpx; }
.input, .textarea, .picker { width: 100%; background: #f5f8fa; border: 1rpx solid #dce5ec; border-radius: 14rpx; padding: 22rpx; color: #102a43; font-size: 28rpx; }
.input { height: 92rpx; }
.textarea { min-height: 150rpx; }
.picker { min-height: 92rpx; }
button { font-size: 28rpx; border-radius: 14rpx; margin: 24rpx 0 0; line-height: 88rpx; font-weight: 600; }
button::after { border: 0; }
.primary { background: #087f8c; color: #fff; }
.secondary { background: #eaf0f5; color: #334e68; }
button[disabled] { background: #d8e1e8; color: #7a8d9e; }
.error { background: #fff0ed; border-radius: 14rpx; padding: 22rpx; color: #a43727; line-height: 1.6; font-size: 26rpx; margin-bottom: 24rpx; }
.notice { background: #eaf3f6; color: #486581; border-radius: 14rpx; padding: 24rpx; font-size: 25rpx; line-height: 1.8; margin-bottom: 24rpx; }
.empty { text-align: center; padding: 64rpx 24rpx; color: #6b7c8e; line-height: 1.8; }
.section { font-size: 32rpx; font-weight: 600; margin: 36rpx 0 20rpx; }
.gap { margin-top: 18rpx; }
.link { color: #087f8c; font-size: 25rpx; }
.record { border-top: 1rpx solid #eef2f6; padding: 22rpx 0; }
.filter { display: flex; gap: 16rpx; margin-bottom: 24rpx; align-items: center; }
.filter .input { flex: 1; min-width: 0; }
.filter button { margin: 0; padding: 0 24rpx; }
.login-mark { width: 88rpx; height: 88rpx; border-radius: 24rpx; background: #102a43; color: #fff; text-align: center; line-height: 88rpx; font-size: 40rpx; font-weight: 700; margin-bottom: 32rpx; }
