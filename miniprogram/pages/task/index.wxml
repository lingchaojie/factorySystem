<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load" disabled="{{updating}}">刷新事项</button></view><view wx:if="{{loading}}" class="empty">正在读取事项…</view>
  <block wx:if="{{item}}"><view class="hero"><view class="eyebrow">ASSIGNED TASK</view><view class="title">{{item.title}}</view></view>
    <view class="card"><view class="row"><view class="name">事项状态</view><text class="badge {{item.overdue ? 'maintenance' : item.status}}">{{item.statusLabel}}</text></view><view class="label">负责人</view><view>{{item.assigneeLabel}}</view><view class="label">截止日期</view><view>{{item.dueDateLabel}}</view><view class="label">事项说明</view><text class="description" selectable="{{true}}">{{item.description || '无补充说明'}}</text><view class="label">创建人</view><view>{{item.createdByName}}</view><view class="muted gap">{{item.createdAtLabel}}</view><view wx:if="{{item.completedAtLabel}}" class="notice gap">{{item.completedByName || '已移除的账号'}} 于 {{item.completedAtLabel}} 完成</view></view>
    <view wx:if="{{item.order}}" class="card" bindtap="openOrder"><view class="label">关联订单</view><view class="name">{{item.order.orderNo}}</view><view class="muted gap">{{item.order.partName}}</view><view class="link gap">查看订单进度 →</view></view>
    <view class="card"><view class="name">更新事项进度</view><view class="muted gap">经理和负责人共用同一进度，重新进入或下拉刷新列表可查看。</view><view class="status-actions"><button class="status-pending {{item.status === 'pending' ? 'primary' : 'secondary'}}" data-status="pending" bindtap="setStatus" disabled="{{updating || item.status === 'pending'}}">待处理</button><button class="status-in-progress {{item.status === 'in_progress' ? 'primary' : 'secondary'}}" data-status="in_progress" bindtap="setStatus" disabled="{{updating || item.status === 'in_progress'}}">处理中</button><button class="complete-task {{item.status === 'completed' ? 'primary' : 'secondary'}}" data-status="completed" bindtap="setStatus" disabled="{{updating || item.status === 'completed'}}">已完成</button></view></view>
  </block>
</view>
