.company { background: #f5f6f4; } .cover { position: relative; padding: 38rpx 38rpx 26rpx; background: #102a43; color: #fff; overflow: hidden; }
.brand { display: flex; align-items: center; gap: 18rpx; margin-bottom: 66rpx; }.brand-icon { width: 64rpx; height: 64rpx; background: #70d9ce; color: #102a43; text-align: center; line-height: 64rpx; font-size: 38rpx; font-weight: 700; border-radius: 12rpx; }.brand-name { font-size: 32rpx; font-weight: 700; letter-spacing: 3rpx; }.brand-sub { font-size: 14rpx; letter-spacing: 2rpx; color: #a8bdcb; margin-top: 6rpx; }.demo-tag { margin-left: auto; font-size: 18rpx; border: 1rpx solid #526d80; border-radius: 6rpx; padding: 5rpx 10rpx; color: #b9cad6; }
.overline { font-size: 23rpx; letter-spacing: 3rpx; color: #79d7cb; margin-bottom: 22rpx; }.headline { font-size: 51rpx; line-height: 1.5; font-weight: 700; letter-spacing: -1rpx; }.intro { margin-top: 24rpx; font-size: 25rpx; line-height: 1.9; color: #bfd0db; max-width: 610rpx; }
.drawing { height: 370rpx; position: relative; margin-top: 26rpx; background-image: linear-gradient(#214056 1rpx, transparent 1rpx), linear-gradient(90deg, #214056 1rpx, transparent 1rpx); background-size: 42rpx 42rpx; border: 1rpx solid #365164; border-radius: 16rpx; overflow: hidden; }.part-ring { position: absolute; width: 230rpx; height: 230rpx; border-radius: 50%; border: 33rpx solid #9bb4c4; left: 50%; top: 47%; transform: translate(-50%, -50%) rotate(-24deg); box-shadow: 12rpx 18rpx 0 #49687d, inset 0 0 0 4rpx #d2e0e8; }.part-core { width: 100%; height: 100%; border-radius: 50%; border: 20rpx solid #38566b; box-shadow: inset 0 0 0 3rpx #70d9ce; }.cross { position: absolute; background: #70d9ce; opacity: .5; }.horizontal { left: 12%; right: 12%; height: 1rpx; top: 47%; }.vertical { top: 10%; bottom: 14%; width: 1rpx; left: 50%; }.drawing-caption, .drawing-id { position: absolute; bottom: 18rpx; font-size: 16rpx; letter-spacing: 1rpx; color: #a9bfcd; }.drawing-caption { left: 18rpx; }.drawing-id { right: 18rpx; }.cover-foot { display: flex; justify-content: space-between; padding-top: 24rpx; font-size: 19rpx; color: #b9cdd8; }
.content { padding: 0 32rpx; }.section-top { display: flex; justify-content: space-between; align-items: end; padding: 56rpx 0 26rpx; }.section-title { font-size: 36rpx; font-weight: 700; line-height: 1.5; }.section-no { color: #8da0a9; font-size: 26rpx; }.capabilities { display: flex; flex-wrap: wrap; gap: 18rpx; }.capability { width: calc(50% - 9rpx); padding: 26rpx; border: 1rpx solid #dce4e3; border-radius: 18rpx; background: #fff; }.wide { width: 100%; }.cap-index { color: #087f8c; font-size: 24rpx; }.cap-title { font-size: 29rpx; font-weight: 600; margin: 14rpx 0 10rpx; }.capability .muted { font-size: 24rpx; }.process { padding: 0 26rpx; background: #fff; border-radius: 18rpx; border: 1rpx solid #dce4e3; }.process-row { padding: 22rpx 0 28rpx; display: flex; gap: 24rpx; border-bottom: 1rpx solid #edf1f0; }.process-row:last-child { border-bottom: 0; }.step { font-size: 25rpx; color: #087f8c; padding-top: 20rpx; }.process-row .muted { font-size: 24rpx; }.portal { margin-top: 48rpx; background: #e0edeb; border-radius: 22rpx; padding: 32rpx; }.portal-copy { font-size: 26rpx; line-height: 1.8; color: #48656c; margin-top: 16rpx; }.portal button { display: flex; justify-content: space-between; padding: 0 26rpx; }.portal-note { font-size: 21rpx; color: #57737a; margin-top: 20rpx; text-align: center; }.footer { padding: 40rpx 0 calc(32rpx + env(safe-area-inset-bottom)); text-align: center; font-size: 24rpx; color: #5e737c; line-height: 2; }.footer view { font-size: 20rpx; color: #88999f; }
.hero-entry { display: inline-block; color: #83e2d5; border-bottom: 1rpx solid #527a86; padding: 14rpx 0 10rpx; margin-top: 16rpx; font-size: 27rpx; font-weight: 600; }
