page { height: 100%; overflow: hidden; }
.company-shell { height: 100vh; display: flex; flex-direction: column; background: #f5f7f6; color: #17313b; }
.company-header { height: 112rpx; padding: 20rpx 28rpx; display: flex; align-items: center; flex-shrink: 0; background: #102c3b; color: #fff; }
.brand-icon { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; background: #83d5c6; color: #102c3b; border-radius: 12rpx; font-size: 37rpx; font-weight: 700; margin-right: 18rpx; }
.brand-name { font-size: 30rpx; font-weight: 700; letter-spacing: 4rpx; }.brand-sub { font-size: 15rpx; letter-spacing: 1.5rpx; color: #a8c3ce; margin-top: 4rpx; }.company-mark { margin-left: auto; color: #afd6d0; font-size: 20rpx; }
.company-layout { flex: 1; display: flex; min-height: 0; overflow: hidden; }
.sidebar { width: 164rpx; flex-shrink: 0; display: flex; flex-direction: column; padding: 26rpx 0 calc(16rpx + env(safe-area-inset-bottom)); background: #eaf0ee; border-right: 1rpx solid #dce6e2; }
.rail-label { font-size: 19rpx; color: #8c9e9a; padding: 0 20rpx 20rpx; letter-spacing: 2rpx; }
.nav-item { width: 100%; min-height: 158rpx; padding: 21rpx 16rpx 22rpx 20rpx; margin: 0; border-radius: 0; line-height: 1.5; text-align: left; display: flex; flex-direction: column; background: transparent; color: #718580; border-left: 5rpx solid transparent; }
.nav-item::after, button::after { border: 0; }.nav-number { font-size: 21rpx; color: #9cafaa; margin-bottom: 8rpx; }.nav-label { font-size: 25rpx; font-weight: 600; white-space: normal; }.nav-english { font-size: 15rpx; letter-spacing: 1rpx; margin-top: 7rpx; }.nav-item.active { background: #fff; color: #087f80; border-left-color: #087f80; }.active .nav-number { color: #087f80; }
.rail-bottom { margin-top: auto; padding: 28rpx 18rpx 0; }.rail-monogram { color: #a2b8b0; font-size: 45rpx; letter-spacing: 2rpx; font-weight: 700; }.staff-entry { padding: 18rpx 0; margin: 0; background: transparent; font-size: 23rpx; color: #476b60; line-height: 1.7; text-align: left; }.staff-entry text { display: block; font-size: 28rpx; }
.section-scroller { flex: 1; width: 0; min-width: 0; height: 100%; background: #fff; }.panel { padding: 34rpx 26rpx 0; }.eyebrow { color: #408c80; letter-spacing: 1.5rpx; font-size: 18rpx; margin-bottom: 15rpx; }.section-title { font-size: 39rpx; line-height: 1.5; font-weight: 700; letter-spacing: -1rpx; }.section-intro { font-size: 24rpx; line-height: 1.8; color: #7a8d88; margin-top: 12rpx; }
.photo-wrap { margin-top: 28rpx; overflow: hidden; border-radius: 14rpx; background: #edf1ef; }.hero-photo { width: 100%; height: 300rpx; display: block; }.photo-caption { color: #6f8580; font-size: 19rpx; line-height: 1.6; padding: 12rpx 14rpx; background: #f0f5f2; }.photo-fallback { width: 100%; height: 240rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #688178; background: #eaf1ed; }
.lead { font-size: 29rpx; font-weight: 600; line-height: 1.6; margin-top: 26rpx; margin-bottom: 12rpx; }.body-copy { font-size: 25rpx; color: #5a716a; line-height: 1.95; }.value-card { padding: 8rpx 24rpx; margin-top: 28rpx; border: 1rpx solid #e1e9e4; border-radius: 14rpx; }.value-card > view { padding: 20rpx 0; border-bottom: 1rpx solid #eaf0ec; }.value-card > view:last-child { border-bottom: 0; }.value-card text { font-weight: 600; color: #166e62; font-size: 25rpx; }.value-card view view { color: #81918c; font-size: 23rpx; margin-top: 7rpx; }.statement { font-size: 28rpx; color: #2a5148; line-height: 1.8; margin: 30rpx 0 16rpx; }.statement view { font-size: 23rpx; color: #87958e; margin-top: 8rpx; }
.section-link { margin: 28rpx 0 0; background: #e9f2ee; color: #146b5c; font-size: 24rpx; padding: 0 16rpx; line-height: 82rpx; border-radius: 12rpx; text-align: left; }
.technology-card { padding: 28rpx 0; border-bottom: 1rpx solid #e8eeea; }.technology-number { color: #6b9c8c; font-size: 18rpx; letter-spacing: 1rpx; }.technology-card .lead { margin-top: 12rpx; }.quality-steps, .material-tags, .part-tags { display: flex; flex-wrap: wrap; margin: 18rpx -5rpx 0; }.quality-steps text, .material-tags text, .part-tags text { font-size: 21rpx; color: #467d6e; padding: 8rpx 12rpx; margin: 0 5rpx 10rpx; background: #edf4ef; border-radius: 6rpx; }.material-box { padding: 6rpx 0 10rpx; }
.product-card { margin-top: 28rpx; border: 1rpx solid #dfe9e1; border-radius: 16rpx; overflow: hidden; background: #fff; }.product-photo { width: 100%; height: 320rpx; display: block; background: #f2f4f2; }.gear-photo { height: auto; min-height: 200rpx; }.product-copy { padding: 24rpx; }.part-number { font-size: 18rpx; color: #8a9c93; letter-spacing: 2rpx; }.product-copy .lead { margin-top: 10rpx; }.product-copy .body-copy { font-size: 24rpx; }.gallery-note { font-size: 21rpx; color: #94a098; line-height: 1.8; margin-top: 24rpx; }
.company-footer { margin: 32rpx 26rpx 0; padding: 28rpx 0 calc(28rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e3ebe5; color: #84988d; font-size: 20rpx; line-height: 1.9; }.footer-note { font-size: 19rpx; margin-top: 8rpx; }.credits-toggle { padding: 12rpx 0; margin: 10rpx 0 0; line-height: 1.8; background: transparent; text-align: left; color: #698c7e; font-size: 21rpx; }.credit-row { padding: 18rpx 0; border-top: 1rpx solid #edf1ed; word-break: break-all; }.credit-row > view { color: #4f7264; }.credit-row text { font-size: 18rpx; }.copy-credit { margin: 10rpx 0 0; line-height: 1.7; padding: 8rpx 12rpx; font-size: 20rpx; color: #477f6b; background: #edf4ef; border-radius: 6rpx; text-align: left; }
