<view class="page">
  <view class="hero"><view class="eyebrow">ASSIGNED TASKS</view><view class="title">{{manager ? '员工指派事项' : '我的指派事项'}}</view><view class="subtitle">{{scope || '按当前工厂和账号权限显示'}}</view></view>
  <view wx:if="{{summary}}" class="card stats task-stats"><view class="stat"><view class="number">{{summary.pending}}</view><view class="muted">待处理</view></view><view class="stat"><view class="number">{{summary.inProgress || 0}}</view><view class="muted">处理中</view></view><view class="stat"><view class="number">{{summary.completed}}</view><view class="muted">已完成</view></view></view><view wx:if="{{summary.overdue}}" class="notice">未完成事项中有 {{summary.overdue}} 项已逾期。</view>
  <button wx:if="{{manager}}" class="primary new-task" bindtap="createForm" loading="{{optionsLoading}}" disabled="{{optionsLoading || creating}}">{{showCreate ? '收起新建表单' : '＋ 创建并指派事项'}}</button>
  <view wx:if="{{error}}" class="error gap">{{error}}</view>
  <view wx:if="{{manager && showCreate}}" class="card gap create-form">
    <view class="name">新建事项</view><view class="label">事项标题 *</view><input class="input" value="{{title}}" data-key="title" bindinput="field" maxlength="120" placeholder="例如：核对订单出货数量" disabled="{{creating}}"/>
    <view class="label">指派员工 *</view><picker class="picker" range="{{employeeLabels}}" value="{{employeeIndex}}" bindchange="employee" disabled="{{creating}}">{{employeeLabels[employeeIndex]}} ▾</picker>
    <view class="label">关联订单（可选）</view><picker class="picker" range="{{orderLabels}}" value="{{orderIndex}}" bindchange="order" disabled="{{creating}}">{{orderLabels[orderIndex]}} ▾</picker>
    <view class="label">截止日期（可选，北京时间）</view><picker class="picker" mode="date" value="{{dueDate || today}}" bindchange="due" disabled="{{creating}}">{{dueDate || '无截止日期，点击选择'}} ▾</picker><view wx:if="{{dueDate && !creating}}" class="link gap" bindtap="clearDue">清除截止日期</view>
    <view class="label">事项说明（可选）</view><textarea class="textarea" value="{{description}}" data-key="description" bindinput="field" maxlength="2000" placeholder="填写处理要求或需要核对的内容" disabled="{{creating}}"/>
    <button class="primary submit-task" bindtap="submit" disabled="{{creating}}" loading="{{creating}}">创建并指派</button>
  </view>
  <picker class="picker gap" range="{{statuses}}" value="{{statusIndex}}" bindchange="choose">{{statuses[statusIndex]}} ▾</picker><view class="gap"></view>
  <view wx:for="{{items}}" wx:key="id" class="card task-card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="name">{{item.title}}</view><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="muted gap">负责人：{{item.assigneeLabel}}</view><view class="muted">截止：{{item.dueDateLabel}}<text wx:if="{{item.overdue}}" class="overdue"> · 已逾期</text></view><view wx:if="{{item.order}}" class="order-label">{{item.order.orderNo}} · {{item.order.partName}}</view><view class="link gap">查看事项 →</view></view>
  <view wx:if="{{loading}}" class="empty">正在读取事项…</view><view wx:if="{{!loading && !error && !items.length}}" class="card empty">暂无符合条件的指派事项。</view>
  <button wx:if="{{hasMore}}" class="secondary" bindtap="more" loading="{{loading}}" disabled="{{loading}}">加载更多（{{items.length}} / {{total}}）</button>
  <view class="notice gap">这里是经理创建的指派事项。交期风险等系统自动待办仍在今日工作台查看。</view>
</view>
