<view class="page">
  <view class="hero"><view class="eyebrow">{{workspaceName}}</view><view class="title">车间机器</view><view class="subtitle">选择机器，录入加工和出货。下拉刷新最新数据。</view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="load">重新加载</button></view>
  <view wx:if="{{loading}}" class="muted">正在读取机器…</view>
  <view wx:for="{{machines}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">
    <view class="row"><view class="name">{{item.name}}</view><text class="badge {{item.status}}">{{item.statusLabel}}</text></view>
    <view class="muted gap">{{item.orders.length}} 个可录入订单</view>
    <view class="stats"><view class="stat"><view class="number">{{item.todayCompleted}}</view><view class="muted">今日加工</view></view><view class="stat"><view class="number">{{item.todayShipped}}</view><view class="muted">今日出货</view></view><view class="stat"><view class="link">查看 / 录入 →</view></view></view>
  </view>
  <view wx:if="{{!loading &amp;&amp; !error &amp;&amp; !machines.length}}" class="card empty">暂无机器。请先在网站创建机器并关联订单。</view>
</view>
