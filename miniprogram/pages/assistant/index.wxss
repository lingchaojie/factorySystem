page { height: 100%; }.chat { height: 100vh; display: flex; flex-direction: column; background: #f3f6f9; }.chat-header { padding: 28rpx 30rpx 24rpx; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1rpx solid #e5edf1; }.chat-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }.chat-header .muted { font-size: 22rpx; }.online-dot { display: inline-block; width: 13rpx; height: 13rpx; border-radius: 50%; background: #087f8c; margin-right: 14rpx; }.clear { color: #087f8c; font-size: 24rpx; padding: 16rpx 0 16rpx 18rpx; }.conversation { flex: 1; min-height: 0; height: 0; }.chat-body { padding: 30rpx 28rpx; }.message { margin-bottom: 32rpx; }.speaker { font-size: 22rpx; color: #6b7c8e; margin-bottom: 10rpx; }.bubble { background: #fff; border: 1rpx solid #e3eaef; border-radius: 6rpx 22rpx 22rpx; padding: 24rpx; line-height: 1.85; font-size: 28rpx; word-break: break-all; white-space: pre-wrap; }.user { margin-left: 70rpx; }.user .bubble { background: #087f8c; border-color: #087f8c; color: #fff; border-radius: 22rpx 6rpx 22rpx 22rpx; }.source { margin-top: 16rpx; padding: 22rpx; background: #fff; border: 1rpx solid #d5e6e5; border-left: 5rpx solid #087f8c; border-radius: 14rpx; }.source-head { display: flex; justify-content: space-between; font-size: 22rpx; }.source-kind { color: #087f8c; }.source-status { color: #6b7c8e; }.source-title { font-size: 29rpx; font-weight: 600; margin-top: 12rpx; }.source-summary { color: #486581; font-size: 24rpx; line-height: 1.8; margin-top: 12rpx; }.source-link { color: #087f8c; font-size: 24rpx; margin-top: 16rpx; }.timestamp { font-size: 20rpx; color: #899aa8; line-height: 1.8; padding-top: 12rpx; }.suggestions { padding-top: 8rpx; }.suggestion { background: #e8f0f4; border-radius: 14rpx; padding: 23rpx; margin-top: 16rpx; font-size: 26rpx; color: #334e68; display: flex; justify-content: space-between; }.suggestion text { color: #087f8c; }.thinking { color: #087f8c; font-size: 25rpx; padding: 10rpx 0 26rpx; }.setup-notice { font-size: 24rpx; color: #6b7c8e; line-height: 1.8; padding: 20rpx 0; }.composer { padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e0e8ee; }.compose-row { display: flex; align-items: flex-end; gap: 16rpx; }.chat-input { flex: 1; width: 0; min-height: 80rpx; max-height: 220rpx; padding: 20rpx; background: #f3f6f9; border: 1rpx solid #dce5ec; border-radius: 16rpx; font-size: 27rpx; line-height: 1.5; }.send { margin: 0; padding: 0 26rpx; background: #087f8c; color: #fff; line-height: 80rpx; font-size: 27rpx; }.compose-note { font-size: 20rpx; color: #8a9aa8; margin-top: 14rpx; text-align: center; }
