APP_SITE_ADDRESS=:80
APP_ORIGIN=http://YOUR_SERVER_IP:18080
APP_HTTP_PORT=18080
APP_HTTPS_PORT=18443

POSTGRES_DB=factory
POSTGRES_USER=factory
POSTGRES_PASSWORD=replace-with-a-long-random-password

NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ALPINE_MIRROR=https://mirrors.tencent.com/alpine

PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_DISPLAY_NAME=平台管理员
PLATFORM_ADMIN_PASSWORD=replace-with-a-long-random-password

BOOTSTRAP_WORKSPACE_NAME=CNC Factory
BOOTSTRAP_CUSTOMER_USERNAME=
BOOTSTRAP_CUSTOMER_DISPLAY_NAME=
BOOTSTRAP_CUSTOMER_PASSWORD=

SESSION_COOKIE_NAME=factory_session
ADMIN_SESSION_COOKIE_NAME=factory_admin_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Existing provider key goes only in the ignored server .env.production file.
FACTORY_AI_BASE_URL=https://www.linx2.ai
FACTORY_AI_API_KEY=
FACTORY_AI_MODEL=gpt-5.6-luna
FACTORY_AI_DATA_SHARING_ENABLED=false
