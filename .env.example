DATABASE_URL="postgresql://factory:factory_password@localhost:5433/factory?schema=public"
APP_ORIGIN="http://localhost:3000"
POSTGRES_DB="factory"
POSTGRES_USER="factory"
POSTGRES_PASSWORD="factory_password"
PLATFORM_ADMIN_USERNAME="admin"
PLATFORM_ADMIN_DISPLAY_NAME="平台管理员"
PLATFORM_ADMIN_PASSWORD="change-me-before-use"
# Optional local-only customer bootstrap. Production customer accounts should be created in /admin.
BOOTSTRAP_WORKSPACE_NAME="CNC Factory"
BOOTSTRAP_CUSTOMER_USERNAME=""
BOOTSTRAP_CUSTOMER_DISPLAY_NAME=""
BOOTSTRAP_CUSTOMER_PASSWORD=""
SESSION_COOKIE_NAME="factory_session"
ADMIN_SESSION_COOKIE_NAME="factory_admin_session"
SESSION_TTL_DAYS="30"
SESSION_COOKIE_SECURE="false"

# Optional read-only miniapp assistant. Keep the real key server-side only.
FACTORY_AI_BASE_URL="https://www.linx2.ai"
FACTORY_AI_API_KEY=""
FACTORY_AI_MODEL="gpt-5.6-luna"
# Enable only after agreeing to send queried progress to the configured provider.
FACTORY_AI_DATA_SHARING_ENABLED="false"
